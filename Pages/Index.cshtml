@page
@model IndexModel
@{
    ViewData["Title"] = "İyi Ki Doğdun Sevgilim! ❤️";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>İyi Ki Doğdun Sevgilim! ❤️</title>

    <!-- Kütüphaneler -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Plus+Jakarta+Sans:wght@300;400;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #ff4d6d;
            --primary-soft: #ffb3c1;
            --accent: #ff758f;
            --bg-gradient: linear-gradient(135deg, #0d0614 0%, #250926 50%, #1a0520 100%);
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.18);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

        body {
            background: var(--bg-gradient);
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .heart-bg {
            position: fixed;
            top: -10vh;
            font-size: 1.5rem;
            color: rgba(255, 77, 109, 0.3);
            animation: fall 8s linear infinite;
            z-index: 0;
            pointer-events: none;
        }

        @@keyframes fall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
        }

        .music-player {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 100;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            padding: 10px 18px;
            border-radius: 30px;
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }

        .music-player:hover {
            transform: scale(1.05);
            background: rgba(255, 77, 109, 0.3);
        }

        nav {
            position: relative;
            z-index: 10;
            margin: 30px 0 10px;
            display: flex;
            gap: 10px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            padding: 8px 16px;
            border-radius: 40px;
            backdrop-filter: blur(16px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }

        nav button {
            border: none;
            background: transparent;
            padding: 12px 22px;
            font-size: 15px;
            font-weight: 600;
            color: rgba(255,255,255,0.7);
            cursor: pointer;
            border-radius: 30px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        nav button.active, nav button:hover {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 5px 20px rgba(255, 77, 109, 0.5);
        }

        .tab-content {
            display: none;
            width: 90%;
            max-width: 850px;
            margin: 20px auto 50px;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.6s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            font-size: 3.8rem;
            color: #ff758f;
            margin-bottom: 5px;
            text-shadow: 0 0 15px rgba(255, 117, 143, 0.4);
        }

        p.subtitle {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 25px;
            font-weight: 300;
        }

        .date-badge {
            display: inline-block;
            background: rgba(255, 77, 109, 0.2);
            border: 1px solid var(--primary);
            padding: 8px 20px;
            border-radius: 20px;
            color: var(--primary-soft);
            font-weight: 600;
            margin-bottom: 20px;
        }

        .envelope-wrapper {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 35px 30px;
            backdrop-filter: blur(12px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            margin-top: 15px;
        }

        .letter-card {
            font-family: 'Caveat', cursive;
            font-size: 1.9rem;
            line-height: 1.6;
            color: #fff;
            text-align: left;
            background: rgba(255,255,255,0.03);
            padding: 30px;
            border-radius: 16px;
            border-left: 5px solid var(--primary);
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
            padding: 10px;
        }

        .polaroid {
            background: #fff;
            padding: 15px 15px 25px 15px;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .polaroid:hover { transform: scale(1.05) rotate(1deg); }

        .polaroid img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 4px;
        }

        .polaroid .caption {
            font-family: 'Caveat', cursive;
            color: #333;
            font-size: 1.6rem;
            margin-top: 12px;
        }

        .cake-stage {
            position: relative;
            height: 300px;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            margin: 30px 0 40px;
        }

        .cake-body {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .layer {
            border-radius: 15px 15px 5px 5px;
            box-shadow: inset 0 -10px 0 rgba(0,0,0,0.15);
        }

        .layer-bottom { width: 250px; height: 80px; background: linear-gradient(180deg, #ff758f, #d63384); }
        .layer-middle { width: 190px; height: 70px; background: linear-gradient(180deg, #ff8fa3, #ff4d6d); }
        .layer-top { width: 130px; height: 50px; background: linear-gradient(180deg, #ffb3c1, #ff758f); }

        .candle-wrapper {
            position: absolute;
            top: -55px;
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
        }

        .candle-stick {
            width: 12px;
            height: 45px;
            background: repeating-linear-gradient(45deg, #fff, #fff 6px, #ff4d6d 6px, #ff4d6d 12px);
            border-radius: 3px;
        }

        .flame-glow {
            width: 18px;
            height: 26px;
            background: radial-gradient(ellipse at bottom, #ffee55 0%, #ff9800 100%);
            border-radius: 50% 50% 20% 20%;
            box-shadow: 0 0 20px #ff9800, 0 0 40px #ff9800;
            margin-bottom: -5px;
            animation: flicker 0.2s infinite alternate;
        }

        @@keyframes flicker {
            0% { transform: scale(1); }
            100% { transform: scale(1.1) rotate(2deg); }
        }

        .action-btn {
            background: linear-gradient(45deg, var(--primary), var(--accent));
            color: white;
            border: none;
            padding: 16px 36px;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(255, 77, 109, 0.4);
            transition: all 0.3s ease;
        }

        .action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(255, 77, 109, 0.6);
        }
    </style>
</head>
<body>

    <!-- Müzik Oynatıcı -->
    <div class="music-player" onclick="toggleMusic()">
        <i class="fa-solid fa-music" id="musicIcon"></i>
        <span id="musicText">Müziği Başlat 🎵</span>
    </div>

    <!-- Müzik Dosyası: wwwroot/sarki.mp3 -->
    <audio id="bgMusic" loop src="/sarki.mp3"></audio>

    <nav>
        <button class="tab-btn active" onclick="switchTab('home', this)">
            <i class="fa-solid fa-heart"></i> Mektup
        </button>
        <button class="tab-btn" onclick="switchTab('gallery', this)">
            <i class="fa-solid fa-camera-retro"></i> Güzel Anılar
        </button>
        <button class="tab-btn" onclick="switchTab('cake', this)">
            <i class="fa-solid fa-cake-candles"></i> Pasta & Dilek
        </button>
    </nav>

    <div id="home" class="tab-content active">
        <div class="date-badge">✨ 6 Ekim Özel Gün ✨</div>
        <h1>İyi Ki Doğdun Bitanemm! ❤️</h1>
        <p class="subtitle">Seninle geçen her an, dünyadaki en güzel hediye...</p>

        <div class="envelope-wrapper">
            <div class="letter-card">
                Canım Sevgilim,<br><br>
                Bugün senin günün! Hayatıma girdiğin ilk andan itibaren dünyamı gülücüklerinle, neşenle ve sonsuz sevginle aydınlattın.<br><br>
                Birlikte güldüğümüz, birlikte biriktirdiğimiz her an benim için çok kıymetli. Yeni yaşında dilediğin tüm hayallerin gerçekleşmesini diliyorum.<br><br>
                İyi ki doğdun, iyi ki benimsin! 💕
            </div>
        </div>
    </div>

    <div id="gallery" class="tab-content">
        <h1>Unutulmaz Anlar 📸</h1>
        <p class="subtitle">Kalbimde yer eden en özel kareler...</p>

        <div class="gallery-grid">
            <div class="polaroid">
                <img src="/resimler/foto1.jpeg" alt="Anı 1">
                <div class="caption">Bakmaya Doyamadığım Gözlerin 🌸</div>
            </div>
            <div class="polaroid">
                <img src="/resimler/foto2.jpeg" alt="Anı 2">
                <div class="caption">Her Şeyi Güzelleştiren Duruşun 🌿</div>
            </div>
            <div class="polaroid">
               <img src="/resimler/foto3.jpeg" alt="Anı 3">
                <div class="caption">Bütün Mevsimleri Bahar Yapan Gülüş 🌼</div>
            </div>
            
        </div>















<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>















<style>
    /* Popup Kutusunun Taşmasını Engelleyen CSS */
    .leaflet-popup-content-wrapper {
        border-radius: 12px;
        padding: 5px;
    }
    .popup-box {
        text-align: center;
        max-width: 210px; /* Sabit Genişlik */
        padding: 4px;
    }
    .popup-box h4 {
        margin: 4px 0;
        color: #e63946;
        font-size: 14px;
    }
    .popup-box p {
        margin: 3px 0;
        font-size: 11px;
        color: #555;
    }

    /* Beyaz Kutu İçindeki Küçük Resim Tasarımı */
    .popup-img-container {
        margin-top: 8px;
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        border: 1px solid #eee;
        cursor: pointer;
    }
    .popup-img-container img {
        width: 100%;
        height: 110px; /* Kutu içi sabit yükseklik */
        object-fit: cover; /* Resmi ezmeden kutuya tam oturtur */
        display: block;
        transition: transform 0.3s ease;
    }
    .popup-img-container:hover img {
        transform: scale(1.05); /* Üzerine gelince tatlı bir yaklaşma efekti */
    }

    .btn-view-pic {
        display: block;
        margin-top: 6px;
        padding: 5px;
        background: #e63946;
        color: white !important;
        border-radius: 6px;
        text-decoration: none;
        font-size: 11px;
        font-weight: bold;
        transition: background 0.2s;
    }
    .btn-view-pic:hover {
        background: #d62828;
    }

    /* Tıklayınca Resmi Ekranın Ortasında Büyüten Modal (Lightbox) */
    .image-modal {
        display: none;
        position: fixed;
        z-index: 99999;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background-color: rgba(0, 0, 0, 0.85);
        justify-content: center;
        align-items: center;
    }
    .image-modal img {
        max-width: 90%;
        max-height: 85%;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .image-modal-close {
        position: absolute;
        top: 20px;
        right: 30px;
        color: white;
        font-size: 35px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<!-- Resim Büyütme Modal Penceresi -->
<div id="imgModal" class="image-modal" onclick="closeImageModal()">
    <span class="image-modal-close">&times;</span>
    <img id="modalImg" src="" />
</div>

<script>
    // Resmi ekranın ortasında tam boy büyüten fonksiyon
    function openImageModal(imgSrc) {
        var modal = document.getElementById("imgModal");
        var modalImg = document.getElementById("modalImg");
        modalImg.src = imgSrc;
        modal.style.display = "flex";
    }

    function closeImageModal() {
        document.getElementById("imgModal").style.display = "none";
    }

    window.addEventListener("load", function () {
        var mekanlar = [
            {
                baslik: "İlk Resim Çekindiğimiz Yer 📸❤️",
                enlem: 40.1885,   // Kendi koordinatlarınız
                boylam: 29.0610,  // Kendi koordinatlarınız
                tarih: "15 Mayıs 2023",
                not: "Birlikte ilk karemiz, unutulmaz anımız...",
                resim: "/images/ilk-resim.jpg"
            },
            {
                baslik: "İlk Randevu & Kahve ☕",
                enlem: 40.2100,
                boylam: 28.9800,
                tarih: "20 Mayıs 2023",
                not: "Heyecandan ellerimin titrediği ilk buluşmamız.",
                resim: "/images/ilk-randevu.jpg"
            }
        ];

        var map = L.map('coordMap', {
            zoomControl: true,
            scrollWheelZoom: true
        }).setView([mekanlar[0].enlem, mekanlar[0].boylam], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        setTimeout(function () {
            map.invalidateSize();
        }, 200);

        var markers = [];
        var shortcutContainer = document.getElementById("shortcutContainer");

        mekanlar.forEach(function (place, index) {
            var marker = L.marker([place.enlem, place.boylam]).addTo(map);

            marker.bindTooltip(place.baslik, {
                permanent: true,
                direction: 'top',
                className: 'map-tooltip'
            });

            // Beyaz Kutunun İçine Düzgün Sığan Resim İçeriği
            var resimHtml = place.resim ? `
                <div class="popup-img-container" onclick="openImageModal('${place.resim}')">
                    <img src="${place.resim}" alt="${place.baslik}" onerror="this.parentElement.style.display='none'" />
                </div>
                <a href="javascript:void(0)" class="btn-view-pic" onclick="openImageModal('${place.resim}')">🔍 Resmi Gör / Büyüt</a>
            ` : '';

            var popupContent = `
                <div class="popup-box">
                    <h4>${place.baslik}</h4>
                    <p><b>📅 ${place.tarih}</b></p>
                    <p>${place.not}</p>
                    ${resimHtml}
                </div>
            `;
            
            marker.bindPopup(popupContent);
            markers.push(marker);

            var card = document.createElement("div");
            card.className = "shortcut-card" + (index === 0 ? " active" : "");
            card.innerHTML = `
                <h4>${place.baslik}</h4>
                <p><b>📅 ${place.tarih}</b></p>
            `;

            card.addEventListener("click", function () {
                document.querySelectorAll('.shortcut-card').forEach(function(c) {
                    c.classList.remove('active');
                });
                card.classList.add('active');

                map.invalidateSize();
                map.setView([place.enlem, place.boylam], 14, {
                    animate: true,
                    pan: { duration: 1 }
                });

                setTimeout(function() {
                    marker.openPopup();
                }, 300);
            });

            shortcutContainer.appendChild(card);
        });
    });
</script>















    </div>

    <div id="cake" class="tab-content">
        <h1>Bir Dilek Tut ve Mumu Üfle! 🕯️</h1>

        <div class="cake-stage">
            <div class="cake-body">
                <div class="candle-wrapper" onclick="blowCandle()">
                    <div class="flame-glow" id="flame"></div>
                    <div class="candle-stick"></div>
                </div>
                <div class="layer layer-top"></div>
                <div class="layer layer-middle"></div>
                <div class="layer layer-bottom"></div>
            </div>
        </div>

        <button class="action-btn" onclick="blowCandle()">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Mumu Üfle ✨
        </button>
    </div>

    <script>
        function switchTab(tabId, btn) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
        }

        let isBlown = false;
        function blowCandle() {
            if (isBlown) return;
            isBlown = true;
            document.getElementById('flame').style.display = 'none';

            const count = 200;
            const defaults = { origin: { y: 0.7 } };

            function fire(particleRatio, opts) {
                confetti(Object.assign({}, defaults, opts, {
                    particleCount: Math.floor(count * particleRatio)
                }));
            }

            fire(0.25, { spread: 26, startVelocity: 55 });
            fire(0.2, { spread: 60 });
            fire(0.35, { spread: 100, decay: 0.91, scalar: 0.8 });
            fire(0.1, { spread: 120, startVelocity: 25, decay: 0.92, scalar: 1.2 });
            fire(0.1, { spread: 120, startVelocity: 45 });
        }

        const audio = document.getElementById('bgMusic');
        function toggleMusic() {
            const icon = document.getElementById('musicIcon');
            const text = document.getElementById('musicText');

            if (audio.paused) {
                audio.play().then(() => {
                    icon.className = "fa-solid fa-pause";
                    text.innerText = "Müziği Durdur";
                }).catch(err => {
                    alert("Müzik çalınamadı. Lütfen wwwroot klasöründe 'sarki.mp3' isimli dosya olduğundan emin olun.");
                });
            } else {
                audio.pause();
                icon.className = "fa-solid fa-music";
                text.innerText = "Müziği Başlat 🎵";
            }
        }

        function createHearts() {
            for(let i=0; i<15; i++) {
                let heart = document.createElement('div');
                heart.className = 'heart-bg';
                heart.innerHTML = '❤️';
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDuration = (Math.random() * 3 + 5) + 's';
                heart.style.fontSize = (Math.random() * 15 + 15) + 'px';
                document.body.appendChild(heart);
            }
        }
        createHearts();
    </script>
</body>
</html>